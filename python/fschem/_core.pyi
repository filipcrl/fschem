from pathlib import Path

class Schematic:
    def __init__(self, path: Path, library_paths: list[Path], discover: bool, variables: dict[str, str] | None = None) -> None: ...
    def source(self) -> str: ...
    def diagnostics(self) -> list[tuple[str, int, str]]: ...
    def netlist(self, backend: str) -> str: ...

def read_raw(path: Path) -> list[tuple[str, str, bool, int | None, list[tuple[str, str, str, str, list[float], list[float]]]]]: ...
def calculate(expression: str, variables: list[tuple[str, str, list[float], list[float]]], scale: int | None) -> tuple[str, str, list[float], list[float]]: ...
def unit(kind: str) -> str: ...
def project_config(start: Path, explicit: Path | None, disabled: bool) -> str: ...
